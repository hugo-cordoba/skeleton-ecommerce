generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())

  passwordChangedAt DateTime?

  addresses   SavedAddress[]
  orders      Order[]
  wishlist    WishlistItem[]
  cartItems   CartItem[]
  resetTokens PasswordResetToken[] // NUEVO
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  CUSTOMER
  ADMIN
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  label    String
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  label    String
  products Product[]
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Product {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  price              String        // se conserva formato "19,90 EUR" para no tocar currency.ts todavía
  compareAtPrice     String?
  image              String
  images             String[]
  href               String?
  badge              String?
  description        String
  shortDescription   String?
  sku                String        @unique
  stock              Int           @default(0)
  status             ProductStatus @default(ACTIVE)

  categorySlug       String
  category           Category      @relation(fields: [categorySlug], references: [slug])

  brandSlug          String?
  brand              Brand?        @relation(fields: [brandSlug], references: [slug])

  variantGroups      ProductVariantGroup[]
  relatedIds         String[] // ids de productos relacionados explícitos

  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  orderItems         OrderItem[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  taxRate            Float         @default(21)

  @@index([status])
}

model ProductVariantGroup {
  id        String                 @id @default(cuid())
  label     String                 // "Talla", "Color"
  productId String
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  options   ProductVariantOption[]
}

model ProductVariantOption {
  id        String              @id @default(cuid())
  label     String
  available Boolean             @default(true)
  groupId   String
  group     ProductVariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model SavedAddress {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String?
  fullName      String
  addressLine1  String
  addressLine2  String?
  city          String
  postalCode    String
  country       String
  phone         String?
  isDefault     Boolean @default(false)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([guestId, productId])
}

model CartItem {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId          String?
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Int
  selectedVariants Json?
  lineId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, lineId])
  @@unique([guestId, lineId])
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  stripeSessionId  String?     @unique
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  guestId          String?
  email            String

  shippingFullName String
  shippingLine1    String
  shippingLine2    String?
  shippingCity     String
  shippingPostal   String
  shippingCountry  String
  shippingPhone    String?

  shippingMethodId    String
  shippingMethodLabel String
  shippingCost        Float

  subtotal         Float
  total            Float
  status           OrderStatus @default(PROCESSING)

  // Reembolsos / cancelación
  refundedAmount   Float?
  refundedAt       DateTime?
  cancelledAt      DateTime?

  // Notas del equipo, nunca visibles para el cliente
  internalNotes    String?

  items            OrderItem[]

  createdAt        DateTime    @default(now())

  buyerRequestsInvoice Boolean     @default(false)
  buyerNif             String?
  buyerLegalName       String?
  invoices             Invoice[]

  @@index([userId])
  @@index([guestId])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  name             String  // snapshot, por si el producto cambia después
  image            String
  unitPrice        Float
  quantity         Int
  selectedVariants Json?
  taxRate          Float   @default(21)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/**
 * Datos fiscales del vendedor (emisor). Fila única, editable desde
 * /admin/settings/fiscal. Cada factura guarda una "foto" de estos datos
 * en el momento de emitirse (Invoice.issuerName/issuerNif/issuerAddress),
 * así que cambiarlos aquí no reescribe facturas ya emitidas.
 */
model FiscalConfig {
  id                String   @id @default(cuid())
  legalName         String
  tradeName         String?
  nif               String
  addressLine1      String
  addressLine2      String?
  postalCode        String
  city              String
  province          String
  country           String   @default("España")
  email             String?
  phone             String?
  invoiceFooterNote String?
  updatedAt         DateTime @updatedAt
}

/**
 * Contador correlativo por serie y año natural. El incremento se hace
 * dentro de una transacción (ver lib/invoicing.ts) para que dos compras
 * simultáneas nunca puedan recibir el mismo número.
 */
model InvoiceSequence {
  id         String @id @default(cuid())
  series     String // "FS" simplificada, "FC" completa, "FR" rectificativa
  year       Int
  lastNumber Int    @default(0)

  @@unique([series, year])
}

enum InvoiceType {
  SIMPLIFIED
  FULL
  RECTIFICATIVE
}

enum InvoiceStatus {
  ISSUED
  RECTIFIED // sustituida por una rectificativa; sigue existiendo, nunca se borra
}

/**
 * Factura emitida. INMUTABLE una vez creada: no hay updateInvoiceAction.
 * Una corrección se hace siempre con una factura rectificativa nueva
 * (generateRectificativeInvoice), nunca editando o borrando esta fila.
 */
model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique // ej. "FS-2026-000123"
  series         String
  year           Int
  sequenceNumber Int
  type           InvoiceType   @default(SIMPLIFIED)
  status         InvoiceStatus @default(ISSUED)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  issuerName    String
  issuerNif     String
  issuerAddress String

  buyerName    String?
  buyerNif     String?
  buyerAddress String?

  subtotal     Float // base imponible total
  taxBreakdown Json // [{ rate: 21, base: 100, quota: 21 }, ...]
  totalTax     Float
  total        Float
  currency     String @default("EUR")

  rectifiesInvoiceId String?  @unique
  rectifiesInvoice   Invoice? @relation("InvoiceRectification", fields: [rectifiesInvoiceId], references: [id])
  rectifiedBy        Invoice? @relation("InvoiceRectification")

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  items InvoiceItem[]

  @@index([orderId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Sin relación/FK a Product a propósito: la factura tiene que seguir
  // siendo legible aunque el producto se archive o desaparezca del catálogo.
  productId String?

  name         String
  quantity     Int
  unitPriceNet Float
  taxRate      Float
  lineNet      Float
  lineTax      Float
  lineTotal    Float
}
